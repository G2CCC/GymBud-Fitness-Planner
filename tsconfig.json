{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@fitness/shared/*": ["shared/src/*"]
    }
  },
  "include": ["shared/src/**/*.ts", "shared/tests/**/*.ts"]
}
