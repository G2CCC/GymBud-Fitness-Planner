# Supabase Dashboard > Connect > Session pooler (port 5432).
# Used by the long-running Express API at runtime.
DATABASE_URL=postgresql://[DB-USER].[PROJECT-REF]:[DB-PASSWORD]@[POOLER-HOST]:5432/postgres?schema=public&sslmode=require

# Supabase Dashboard > Connect > Direct connection.
# Used by Prisma migrations and database administration commands.
DIRECT_URL=postgresql://[DB-USER]:[DB-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?schema=public&sslmode=require

API_URL=http://localhost:3000
PORT=3000

# Supabase Auth. Use AUTH_PROVIDER=fake only for Vitest or explicit E2E setup.
AUTH_PROVIDER=supabase
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=[PUBLIC-ANON-KEY]
SUPABASE_SERVICE_ROLE_KEY=
EXERCISE_IMAGE_BUCKET=exercise-images
CORS_ORIGINS=http://localhost:5173

# Vite client values (public only; do not place database or service-role keys here).
VITE_API_URL=http://localhost:3000/api
VITE_SUPABASE_URL=https://[PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=[PUBLIC-ANON-KEY]

# Optional OpenAI-compatible provider configuration.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Set to fake only for local deterministic E2E tests.
AI_PROVIDER=openai
