generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ActivityType {
  STRENGTH
  CARDIO
  SPORT
}

enum Sex {
  MALE
  FEMALE
}

enum BodyGoal {
  FAT_LOSS
  MUSCLE_GAIN
  MAINTENANCE
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum EnergyCoverage {
  COMPLETE
  PARTIAL
  UNAVAILABLE
}

enum WorkoutStatus {
  PLANNED
  COMPLETED
}

enum CycleStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum WeightUnit {
  KG
  LB
}

model User {
  id                String             @id @default(cuid())
  authUserId        String?            @unique
  email             String             @unique
  createdAt         DateTime           @default(now())
  profile           UserProfile?
  cycles            TrainingCycle[]
  scheduledWorkouts ScheduledWorkout[]
  exercises         Exercise[]
  nutritionTargets NutritionTarget[]
  nutritionDays NutritionDay[]
  foodLogs FoodLog[]
  recommendations   AIRecommendation[]
}

model UserProfile {
  userId                 String   @id
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  primaryGoal            BodyGoal
  weeklyTrainingDays     Int
  sessionDurationMinutes Int
  sex                    Sex
  recordingTimezone      String @default("UTC")
  nutritionStartedOn     String? @db.VarChar(10)
  age                    Int
  heightCm               Float
  weightKg               Float
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model TrainingCycle {
  id             String               @id @default(cuid())
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate      DateTime
  endDate        DateTime
  timezone       String?
  cycleNumber    Int?
  status         CycleStatus          @default(DRAFT)
  closedAt       DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  workouts       ScheduledWorkout[]
  reviewSnapshot CycleReviewSnapshot?

  @@unique([userId, cycleNumber])
  @@index([userId, status])
  @@index([userId, startDate])
}

model ScheduledWorkout {
  id               String             @id @default(cuid())
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycleId          String
  cycle            TrainingCycle      @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  activityType     ActivityType
  scheduledDate    DateTime
  durationMinutes  Int
  status           WorkoutStatus      @default(PLANNED)
  rescheduleCount  Int                @default(0)
  completedAt      DateTime?
  plannedDetails   Json?
  activityOptionId String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  plannedExercises PlannedExercise[]
  workoutLog       WorkoutLog?
  recommendations  AIRecommendation[]
  activityOption   ActivityOption?    @relation(fields: [activityOptionId], references: [id], onDelete: Restrict)

  @@index([userId, scheduledDate])
  @@index([cycleId, status])
  @@index([userId, status])
  @@index([activityOptionId])
}

model PlannedExercise {
  id          String           @id @default(cuid())
  workoutId   String
  workout     ScheduledWorkout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId  String
  exercise    Exercise         @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  sortOrder   Int
  restSeconds Int?
  plannedSets PlannedSet[]

  @@unique([workoutId, sortOrder])
  @@index([exerciseId, workoutId])
}

model PlannedSet {
  id                String          @id @default(cuid())
  plannedExerciseId String
  plannedExercise   PlannedExercise @relation(fields: [plannedExerciseId], references: [id], onDelete: Cascade)
  setNumber         Int
  targetReps        Int
  plannedWeight     Float?
  weightUnit        WeightUnit?

  @@unique([plannedExerciseId, setNumber])
}

model WorkoutLog {
  id            String           @id @default(cuid())
  workoutId     String           @unique
  workout       ScheduledWorkout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  estimatedCaloriesKcal Int?
  energyMethod String?
  energyVersion String?
  energyInputs Json?
  energyCoverage EnergyCoverage?
  completedLocalDate String? @db.VarChar(10)
  timezone String?
  actualDetails Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  exerciseLogs  ExerciseLog[]
}

model ExerciseLog {
  id           String     @id @default(cuid())
  workoutLogId String
  workoutLog   WorkoutLog @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)
  exerciseId   String
  exercise     Exercise   @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  sortOrder    Int
  setLogs      SetLog[]

  @@unique([workoutLogId, sortOrder])
  @@index([exerciseId, workoutLogId])
}

model SetLog {
  id            String      @id @default(cuid())
  exerciseLogId String
  exerciseLog   ExerciseLog @relation(fields: [exerciseLogId], references: [id], onDelete: Cascade)
  setNumber     Int
  actualReps    Int
  actualWeight  Float
  weightUnit    WeightUnit

  @@unique([exerciseLogId, setNumber])
}

model Exercise {
  id               String             @id @default(cuid())
  ownerId          String?
  owner            User?              @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  name             String
  description      String?
  equipment        String?
  targetMuscles    String[]
  movementPattern  String?
  sourceProvider   String?
  sourceId         String?
  sourceCommit     String?
  sourceCategory   String?
  level            String?
  primaryMuscles   String[]           @default([])
  secondaryMuscles String[]           @default([])
  focusAreas       String[]           @default([])
  instructions     String[]           @default([])
  imagePaths       String[]           @default([])
  aiEligible       Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  plannedExercises PlannedExercise[]
  exerciseLogs     ExerciseLog[]
  recommendations  AIRecommendation[]

  @@index([ownerId, name])
  @@unique([sourceProvider, sourceId])
}

model ActivityOption {
  id                String             @id
  activityType      ActivityType
  slug              String             @unique
  name              String
  iconKey           String
  aiEligible        Boolean            @default(true)
  sortOrder         Int
  description       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  scheduledWorkouts ScheduledWorkout[]

  @@index([activityType, aiEligible, sortOrder])
}

model AIRecommendation {
  id                String            @id @default(cuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId        String?
  exercise          Exercise?         @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  workoutId         String?
  workout           ScheduledWorkout? @relation(fields: [workoutId], references: [id], onDelete: SetNull)
  kind              String
  recommendedWeight Float?
  weightUnit        WeightUnit?
  reason            String
  status            String
  inputContext      Json?
  createdAt         DateTime          @default(now())

  @@index([exerciseId, createdAt])
  @@index([userId, createdAt])
}

model CycleReviewSnapshot {
  id                   String        @id @default(cuid())
  cycleId              String        @unique
  cycle                TrainingCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  nutritionSummary Json?
  processedSummary     String?
  objectiveSummary     Json
  previousCycleSummary Json?
  conclusions          Json
  nextCycleDraft       Json
  reviewedAt           DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

model Food {
  id String @id @default(cuid())
  name String
  sourceProvider String
  sourceId String
  sourceRelease String
  kcalPer100g Decimal @db.Decimal(14,4)
  proteinPer100g Decimal @db.Decimal(14,4)
  carbsPer100g Decimal @db.Decimal(14,4)
  fatPer100g Decimal @db.Decimal(14,4)
  active Boolean @default(true)
  portions FoodPortion[]
  logs FoodLog[]
  @@unique([sourceProvider, sourceRelease, sourceId])
  @@index([active, name, id])
}

model FoodPortion {
  id String @id @default(cuid())
  foodId String
  food Food @relation(fields: [foodId], references: [id], onDelete: Restrict)
  sourcePortionId String
  label String
  quantity Decimal @db.Decimal(14,4)
  grams Decimal @db.Decimal(14,4)
  unitGrams Decimal @db.Decimal(14,4)
  active Boolean @default(true)
  logs FoodLog[]
  @@unique([foodId, sourcePortionId])
}

model NutritionTarget {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  effectiveDate String @db.VarChar(10)
  kcal Int
  proteinG Decimal @db.Decimal(12,1)
  carbsG Decimal @db.Decimal(12,1)
  fatG Decimal @db.Decimal(12,1)
  profileSnapshot Json
  algorithmVersion String
  @@unique([userId, effectiveDate])
}

model NutritionDay {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  localDate String @db.VarChar(10)
  timezone String
  completedAt DateTime?
  revision Int @default(0)
  entries FoodLog[]
  @@unique([userId, localDate])
}

model FoodLog {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayId String
  day NutritionDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  mealType MealType
  foodId String
  food Food @relation(fields: [foodId], references: [id], onDelete: Restrict)
  portionId String?
  portion FoodPortion? @relation(fields: [portionId], references: [id], onDelete: Restrict)
  quantity Decimal @db.Decimal(14,4)
  unit String
  grams Decimal @db.Decimal(14,4)
  nameSnapshot String
  per100gSnapshot Json
  unitGramsSnapshot Decimal? @db.Decimal(14,4)
  kcal Decimal @db.Decimal(14,4)
  proteinG Decimal @db.Decimal(14,4)
  carbsG Decimal @db.Decimal(14,4)
  fatG Decimal @db.Decimal(14,4)
  clientRequestId String
  requestFingerprint String
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, clientRequestId])
  @@index([dayId, deletedAt])
}
